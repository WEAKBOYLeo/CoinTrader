# CoinTrader 环境变量模板
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中。
#
# ⚠️ 硬规则（docs/ARCHITECTURE.md §4.2）：
#   1. 密钥只从环境变量读，永不写入任何代码或配置文件
#   2. API Key 创建时【绝对不要】勾选"允许提现"
#   3. 务必绑定 IP 白名单
#   4. 泄露后立即在币安后台删除该 Key

# --- 真实盘密钥（默认不读取；只有 TRADING_ENABLED 才会被加载） ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- 测试网密钥（推荐从这里开始）---
# 两种平台二选一（当前项目用 Demo Trading）：
#   Demo Trading（官方模拟盘，推荐）: 登录币安 → demo.binance.com → API Management，一对 key 现货+合约通用
#   经典测试网: https://testnet.binancefuture.com（合约）+ https://testnet.binance.vision（现货，key 不通用）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# 仅「经典测试网」需要：现货与合约 key 不通用，用这组覆盖现货腿（不填则回退用主密钥）
# 申请地址: https://testnet.binance.vision
# COINTRADER_SPOT_API_KEY=
# COINTRADER_SPOT_API_SECRET=

# --- 安全闸门 ---
# 真实下单需要这个变量精确等于下面的字符串。写 "1" / "true" / "yes" 都不生效。
# 这是刻意的摩擦：让你在下真单前必须停下来想一次。
# COINTRADER_TRADING_ENABLED=YES_I_AM_SURE

# 默认使用测试网。设为 "false" 才会连真实盘（还需上面的开关）。
COINTRADER_USE_TESTNET=true

# 全局停机开关：只要这个文件存在，一切下单被拒绝。
# 用法: touch KILL_SWITCH  → 立即停机（无需改代码或重启）
COINTRADER_KILL_SWITCH_FILE=KILL_SWITCH

# 代理（可选，若服务器访问币安受限）
# HTTPS_PROXY=
